# Copia este archivo como .env y completa los valores. El .env no se versiona.

# Proveedor del LLM: "groq" o "ninguno". Con "ninguno" la clasificación
# se hace solo con las reglas de cada empresa.
LLM_PROVEEDOR=groq

# Modelo del proveedor. openai/gpt-oss-20b admite salida JSON con esquema estricto.
LLM_MODELO=openai/gpt-oss-20b

# URL base compatible con OpenAI. Cambiarla permite usar otro proveedor compatible.
LLM_URL_BASE=https://api.groq.com/openai/v1

# Clave del proveedor. Se crea en https://console.groq.com/keys
GROQ_API_KEY=

# Segundos que se espera la respuesta del LLM antes de usar las reglas.
LLM_TIMEOUT_S=10

# Cortocircuito: tras esta cantidad de fallas seguidas del LLM, se usan las reglas sin
# llamarlo durante la pausa (en segundos). Evita esperar el timeout en cada solicitud.
LLM_FALLAS_PARA_ABRIR=3
LLM_PAUSA_CORTOCIRCUITO_S=30

# Servicios de prioridad de los clientes (MENSAJERIA DEL VALLE): "activa" o "ninguna".
# Con "ninguna" cada empresa usa sus reglas. La URL de cada servicio va en el YAML.
PRIORIDAD_EXTERNA=activa

# Carpeta de los YAML de empresa. Sin valor, configuracion/empresas del repositorio.
# CARPETA_EMPRESAS=/ruta/a/empresas
